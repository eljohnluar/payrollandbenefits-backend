# ── Payroll API backend configuration ─────────────────
# Copy to backend/.env and fill in. Never commit the real .env.

APP_DEBUG=1
FRONTEND_ORIGIN=http://localhost:5173

# Supabase project (optional — used only for browser realtime via the anon key).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=

# Database connection used by PHP (PDO). Default is a direct local PostgreSQL
# connection — no Supabase connection pooling required. To target Supabase
# instead, set its host/user (user is "postgres.<ref>") and sslmode=require.
SUPABASE_DB_HOST=127.0.0.1
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=payroll
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=disable

# Or provide the whole DSN instead of the fields above:
# DATABASE_URL=postgresql://postgres:PASSWORD@127.0.0.1:5432/payroll?sslmode=disable

# Signing secret for locally issued dev tokens when Supabase Auth is not wired up yet.
APP_SECRET=change-me-in-production

# Gate code users must enter on the Register page (case-insensitive). Leave unset to disable self-registration.
REGISTRATION_CODE=

# Optional: mail relay webhook (e.g. a Supabase Edge Function fronting Resend/Postmark).
# Payslip release emails are recorded in email_outbox either way; this makes them actually send.
MAIL_WEBHOOK_URL=
